{
  "name": "lnemail-extension",
  "private": true,
  "version": "0.3.0",
  "description": "Cross-browser extension (Chrome + Firefox, MV3) to create, autofill, and manage LNemail accounts with optional NWC auto-payments.",
  "type": "module",
  "scripts": {
    "build": "bun run build.js",
    "package": "bun run build.js --zip",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "test": "bun test"
  },
  "dependencies": {
    "nostr-tools": "^2.10.4",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "web-ext": "10.5.0"
  }
}
